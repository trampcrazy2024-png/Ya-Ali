{
  "name": "ya-ali",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm --workspace apps/mobile run dev",
    "build": "npm --workspace apps/mobile run build",
    "typecheck": "npm --workspace apps/mobile run typecheck",
    "test": "npm --workspace apps/mobile run test",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
